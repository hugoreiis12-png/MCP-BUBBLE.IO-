# Variáveis da stack no Portainer (Stacks → Environment variables → Advanced mode, cole e preencha).
# Nunca versione o arquivo preenchido.
BUBBLE_APP_URL=https://meuapp.bubbleapps.io
# Settings > API > API Tokens. Token de admin ignora privacy rules.
BUBBLE_API_TOKEN=
# test = /version-test | live
BUBBLE_ENV=test
# Teto de modo do servidor: nenhum client passa disso.
BUBBLE_MODE=read-only
BUBBLE_ALLOW_LIVE_WRITES=false
BUBBLE_WORKFLOW_ALLOWLIST=
# IP da VM na rede interna (obrigatório). A porta 8787 só é publicada nele.
BRIDGE_BIND_IP=
# Só se algum client rodar no navegador (ex.: http://portal.interno). Vazio = recusa Origin.
BUBBLE_BRIDGE_ALLOWED_ORIGINS=
