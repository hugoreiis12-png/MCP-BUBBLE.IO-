# Variáveis da stack no Portainer (Stacks → Environment variables → Advanced mode, cole e preencha).
# Nunca versione o arquivo preenchido.
BUBBLE_APP_URL=https://meuapp.bubbleapps.io
# Settings > API > API Tokens. Token de admin ignora privacy rules.
BUBBLE_API_TOKEN=
# test = /version-test | live
BUBBLE_ENV=test
# Teto de modo do servidor: nenhum client passa disso.
BUBBLE_MODE=read-only
BUBBLE_ALLOW_LIVE_WRITES=false
BUBBLE_WORKFLOW_ALLOWLIST=
# IP da VM na rede interna (obrigatório). A porta 8787 só é publicada nele.
BRIDGE_BIND_IP=
# Só se algum client rodar no navegador (ex.: http://portal.interno). Vazio = recusa Origin.
BUBBLE_BRIDGE_ALLOWED_ORIGINS=
# true só atrás de proxy TLS confiável (rate limit usa o X-Forwarded-For).
BUBBLE_BRIDGE_TRUST_PROXY=false
# --- Plano de design ---
# Cookie da CONTA Bubble COM o nome: meta_test_u2main=bus|… (só o valor dá 401). Alcança todos os apps da conta.
BUBBLE_EDITOR_SESSION=
# JWT do Firebase (header meta-firebase_workflow). Expira em 1 h: depois disso o editor volta 401.
BUBBLE_EDITOR_FIREBASE_TOKEN=
# Slug do app no editor (ex.: comprover).
BUBBLE_EDITOR_APP_ID=
# version-test | version-live
BUBBLE_EDITOR_BRANCH=version-test
# Vazio = https://scheduled.bubble.io
BUBBLE_EDITOR_BASE=
# Vazio = operações padrão. JSON inline ou caminho dentro do volume (ex.: /data/editor-ops.json).
BUBBLE_EDITOR_OPS=
