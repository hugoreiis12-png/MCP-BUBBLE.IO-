# Copie para .env (chmod 600) e preencha. Nunca versione o .env.
BUBBLE_APP_URL=https://meuapp.bubbleapps.io
# Settings > API > API Tokens. Token de admin ignora privacy rules — prefira começar sem ele.
BUBBLE_API_TOKEN=
# test = /version-test (padrão) | live
BUBBLE_ENV=test
# read-only (padrão) | read-write (criar, alterar, workflows) | admin (+ apagar)
BUBBLE_MODE=read-only
# Escrita no live exige opt-in explícito
BUBBLE_ALLOW_LIVE_WRITES=false
# Backend workflows que o agente pode disparar, separados por vírgula
BUBBLE_WORKFLOW_ALLOWLIST=
BUBBLE_AUDIT_LOG=./logs/audit.jsonl
BUBBLE_EXPORT_DIR=./exports
# Transporte remoto (serve --http): token por client (preferido) ou token único.
# BUBBLE_BRIDGE_CLIENTS_FILE=./clients.json
# BUBBLE_BRIDGE_HTTP_TOKEN=
# BUBBLE_BRIDGE_TRUST_PROXY=false
# BUBBLE_BRIDGE_ALLOWED_ORIGINS=
# BUBBLE_BRIDGE_HTTP_HOST=127.0.0.1
# BUBBLE_BRIDGE_HTTP_PORT=8787
# --- Plano de design (opcional) ---
# Sessão da CONTA Bubble (cookie meta_test_u2main / meta_live_u2main). Sem ela, as tools
# de editor não são registradas. Risco: essa sessão alcança todos os apps editáveis pela conta.
# BUBBLE_EDITOR_SESSION=
# BUBBLE_EDITOR_APP_ID=
# BUBBLE_EDITOR_BRANCH=version-test
# BUBBLE_EDITOR_API_BASE=https://editor.bubbleapps.io/version-test/api/1.1/
# Mapa JSON das operações de design autorizadas: {"read_design":{"method":"GET","path":"/wf/..."}}
# BUBBLE_EDITOR_OPS=
# Teto de itens por cursor num GET: 50000 (10000000 no Enterprise)
BUBBLE_SEARCH_CAP=50000
